{
  "id": "downloads-by-type",
  "displayOrder": 1,
  "defaultChecked": true,
  "evalOrder": 4,
  "name": {
    "ro": "Descărcări după tip",
    "en": "Downloads by type"
  },
  "description": {
    "ro": "Mută fișierele din Descărcări în subfolderele Imagini, Documente, Arhive, Instalatoare, Video și Audio.",
    "en": "Moves files from Downloads into the subfolders Images, Documents, Archives, Installers, Videos and Music."
  },
  "defaultScope": [
    "{downloads}"
  ],
  "rules": [
    {
      "idSuffix": "image",
      "name": {
        "ro": "Descărcări după tip: imagini",
        "en": "Downloads by type: images"
      },
      "conditions": [
        {
          "type": "typeGroup",
          "value": "image"
        }
      ],
      "actions": [
        {
          "type": "moveTo",
          "params": {
            "path": {
              "ro": "Imagini",
              "en": "Images"
            }
          }
        }
      ],
      "options": {
        "topLevelOnly": true
      }
    },
    {
